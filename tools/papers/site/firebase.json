{
  "hosting": {
    "site": "chamui-papers",
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.pdf", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
    ]
  }
}
